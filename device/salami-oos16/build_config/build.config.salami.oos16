
# build.config for oneplus 11, all avbtool data provided here are extract using : avbtool info_image --image ${image}
BOOT_AVBTOOL_PROPS=" \
com.android.build.boot.os_version:13 \
com.android.build.boot.fingerprint:qti/kalama/kalama:13/TP1A.220905.001/1739881287021:user/release-keys \
com.android.build.boot.security_patch:2025-02-01 \
com.android.build.boot.security_patch:2025-02-01  \
"

VENDOR_BOOT_AVBTOOL_PROPS="com.android.build.vendor_boot.fingerprint:qti/kalama/kalama:13/TP1A.220905.001/1765954262790:user/release-keys"
AVB_SIGN_VENDOR_BOOT_ROLLBACK_INDEX=1

VENDOR_DLKM_AVBTOOL_PROPS=" \
com.android.build.vendor_dlkm.os_version:13 \
com.android.build.vendor_dlkm.fingerprint:qti/kalama/kalama:13/TP1A.220905.001/1765954262790:user/release-keys \
"

VENDOR_DLKM_FS_TYPE="erofs"

SYSTEM_DLKM_AVBTOOL_PROPS=" \
com.android.build.system_dlkm.os_version:13 \
com.android.build.system_dlkm.fingerprint:qti/kalama/kalama:13/TP1A.220905.001/1765954262790:user/release-keys \
"

SYSTEM_DLKM_FS_TYPE="erofs"

# FEC num roots for dlkm partitions
SYSTEM_DLKM_FEC_NUM_ROOTS="2"
VENDOR_DLKM_FEC_NUM_ROOTS="2"

# warning: update this to 1 or remove this entirely if ever updating the prebuilt binaries for this specific device or globally
AVBTOOL_GENERATES_FEC_BY_DEFAULT=0
